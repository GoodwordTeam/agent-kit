+# --- fake agent-kit ---------------------------------------------------------
+
+# fm_test_fake_agent_kit <config-dir> <bin-dir>
+# Writes an `ak` stub at <bin-dir>/ak, worker settings at
+# <bin-dir>/worker-settings.json, and <config-dir>/agent-kit.env naming both.
+# `ak firstmate bind` appends its arguments to <bin-dir>/ak.calls, writes the
+# --binding-out JSON, and prints a `# agent-kit binding` section. Set
+# FM_FAKE_AK_BIND to fail (exit 3), noheading, contract (adds a
+# `Delivery contract: mode=` line), or nojson to break one acceptance rule.
+fm_test_fake_agent_kit() {
+  local config=$1 bindir=$2
+  mkdir -p "$config" "$bindir"
+  cat > "$bindir/ak" <<SH
+#!/usr/bin/env bash
+printf '%s\\n' "\$*" >> '$bindir/ak.calls'
+out=
+while [ "\$#" -gt 0 ]; do
+  [ "\$1" = --binding-out ] && out=\$2
+  shift
+done
+case "\${FM_FAKE_AK_BIND:-ok}" in
+  fail) printf 'partial\\n' > "\$out"; exit 3 ;;
+  noheading) printf '{}\\n' > "\$out"; printf '%s\\n' '# Something else'; exit 0 ;;
+  contract) printf '{}\\n' > "\$out"; printf '%s\\n' '# agent-kit binding' 'Delivery contract: mode=no-mistakes'; exit 0 ;;
+  nojson) printf '%s\\n' '# agent-kit binding' 'Lifecycle: fake'; exit 0 ;;
+esac
+printf '{"binding":"fake"}\\n' > "\$out"
+printf '%s\\n' '# agent-kit binding' 'Lifecycle: super-plan, super-build, super-verify, super-review, super-ship.' "Binding file: \$out"
+SH
+  chmod +x "$bindir/ak"
+  printf '%s\n' '{"hooks":{"PreToolUse":[{"matcher":"*","hooks":[{"type":"command","command":"ak-child-guard --binding __AK_FIRSTMATE_BINDING__"}]}]}}' \
+    > "$bindir/worker-settings.json"
+  printf '%s\n' '# agent-kit binding for firstmate' \
+    "AK_FIRSTMATE_BIN=$bindir/ak" \
+    'AK_FIRSTMATE_PATCH=0001-agent-kit-mode' \
+    "AK_FIRSTMATE_WORKER_SETTINGS='$bindir/worker-settings.json'" > "$config/agent-kit.env"
+}
