+# Promotion into agent-kit binds exactly as a fresh brief does: the promoted worker
+# receives the same Definition of done and binding, and a refused bind leaves the
+# scout untouched.
+test_agent_kit_promotion_carries_the_brief_contract() {
+  local home proj sendroot meta id=ak-promote-1 out status payload brief_contract delivered_contract
+  home="$TMP_ROOT/ak-promote/home"
+  proj="$TMP_ROOT/ak-promote/projects/ak-proj"
+  sendroot="$TMP_ROOT/ak-promote/sendroot"
+  mkdir -p "$home/state" "$home/data" "$proj" "$sendroot/bin"
+  home=$(cd "$home" && pwd -P)
+  proj=$(cd "$proj" && pwd -P)
+  fm_test_fake_agent_kit "$home/config" "$home/akbin"
+  cat > "$sendroot/bin/fm-send.sh" <<'STUB'
+#!/usr/bin/env bash
+printf '%s' "$2" > "$FM_TEST_CAPTURE"
+STUB
+  chmod +x "$sendroot/bin/fm-send.sh"
+  meta="$home/state/$id.meta"
+  printf 'window=fm-%s\nkind=scout\nworktree=/tmp/wt\nproject=%s\n' "$id" "$proj" > "$meta"
+  FM_HOME="$home" "$BRIEF" "$id" "$proj" --scout >/dev/null 2>&1 || fail "scout brief generation should succeed"
+  fill_brief_subsections "$home/data/$id/brief.md" "Ship the agent-kit change." "Keep the bound lifecycle."
+  cp "$home/data/$id/brief.md" "$TMP_ROOT/ak-promote/scout-brief"
+
+  out=$(FM_HOME="$home" FM_STATE_OVERRIDE="$home/state" FM_CONFIG_OVERRIDE="$home/config" FM_FAKE_AK_BIND=fail \
+    "$PROMOTE" "$id" --mode agent-kit --yolo off 2>&1)
+  status=$?
+  [ "$status" -ne 0 ] || fail "promotion with a failing bind should exit non-zero"
+  assert_contains "$out" "agent-kit bind refused; task $id was not promoted" "refused promotion did not explain itself"
+  assert_grep 'kind=scout' "$meta" "refused bind still promoted the task"
+  assert_no_grep '^mode=' "$meta" "refused bind recorded a delivery mode"
+  assert_absent "$home/data/$id/agent-kit-binding.json" "refused bind left a binding"
+  assert_absent "$home/data/$id/ship-instructions.md" "refused bind published ship instructions"
+  cmp -s "$home/data/$id/brief.md" "$TMP_ROOT/ak-promote/scout-brief" || fail "refused bind changed the scout brief"
+
+  out=$(FM_HOME="$home" FM_STATE_OVERRIDE="$home/state" FM_CONFIG_OVERRIDE="$home/config" \
+    "$PROMOTE" "$id" --mode agent-kit --yolo off 2>&1) || fail "agent-kit promotion should succeed: $out"
+  assert_grep 'mode=agent-kit' "$meta" "promotion did not record mode=agent-kit"
+  assert_present "$home/data/$id/agent-kit-binding.json" "promotion wrote no binding JSON"
+  grep -qxF -- "firstmate bind --fm-home $home --task-id $id --project $proj --mode agent-kit --binding-out $home/data/$id/agent-kit-binding.json" \
+    "$home/akbin/ak.calls" || fail "promotion did not call ak with the bind interface"
+  payload="$TMP_ROOT/ak-promote/payload"
+  ( cd "$sendroot" \
+    && FM_TEST_CAPTURE="$payload" \
+       eval "$(printf '%s\n' "$out" | sed -n 's/^next: //p' | grep 'fm-send\.sh')" ) \
+    || fail "promotion's delivery command did not run"
+  grep -qx '# agent-kit binding' "$home/data/$id/brief.md" || fail "promoted brief lacks the binding a relaunch needs"
+
+  # The fresh brief ends with its DoD and binding; so do the promoted instructions.
+  rm "$home/data/$id/brief.md"
+  FM_HOME="$home" "$BRIEF" "$id" "$proj" --mode agent-kit >/dev/null 2>&1 || fail "fresh agent-kit brief should succeed"
+  brief_contract="$TMP_ROOT/ak-promote/brief-contract"
+  delivered_contract="$TMP_ROOT/ak-promote/delivered-contract"
+  awk '/^# Definition of done$/ { emit=1 } emit' "$home/data/$id/brief.md" > "$brief_contract"
+  awk '/^# Definition of done$/ { emit=1 } emit' "$payload" > "$delivered_contract"
+  assert_grep '# agent-kit binding' "$delivered_contract" "promoted worker did not receive the binding"
+  cmp -s "$brief_contract" "$delivered_contract" \
+    || fail "promotion and a fresh brief delivered different agent-kit contracts"
+  pass "fm-promote: agent-kit promotion binds like a fresh brief, and a refused bind changes nothing"
+}
