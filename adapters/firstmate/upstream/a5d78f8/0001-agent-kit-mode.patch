+# agent-kit has no pre-ship handoff: a summary done: is gated like any other,
+# and an unpushed head is refused even on the CI-ready evidence line.
+test_agent_kit_every_done_is_gated() {
+  local repo wt sha reason rc
+  repo="$TMP_ROOT/ak-gate-repo"
+  wt="$TMP_ROOT/ak-gate-wt"
+  fm_git_worktree "$repo" "$wt" fm/ak-gate
+  git -C "$wt" commit -q --allow-empty -m 'only in the disposable copy'
+  sha=$(git -C "$wt" rev-parse HEAD)
+  rc=0
+  accept_done ship agent-kit "$wt" "$repo" 'done: implemented the fix' >/dev/null || rc=$?
+  [ "$rc" -eq 1 ] || fail "agent-kit summary done: skipped the gate (exit $rc)"
+  rc=0
+  reason=$(accept_done ship agent-kit "$wt" "$repo" \
+    'done [at=1]: PR https://github.com/o/r/pull/7 checks green evidence=plan,verify,review') || rc=$?
+  [ "$rc" -eq 1 ] || fail "agent-kit CI-ready done: with an unpushed head was accepted"
+  case "$reason" in
+    *"named head $sha is unreachable outside the worker copy") ;;
+    *) fail "agent-kit refusal did not name the unpushed commit: $reason" ;;
+  esac
+  git -C "$wt" update-ref refs/remotes/no-mistakes/fm/ak-gate "$sha"
+  accept_done ship agent-kit "$wt" "$repo" \
+    'done [at=1]: PR https://github.com/o/r/pull/7 checks green evidence=plan,verify,review' \
+    || fail "agent-kit done: whose head the transport pushed was refused"
+  pass "every agent-kit ship done: is gated on the worker head"
+}
