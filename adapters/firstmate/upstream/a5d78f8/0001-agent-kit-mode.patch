+# An agent-kit spawn launches only a task that was bound: the binding JSON and the
+# brief's `# agent-kit binding` section must both exist, or nothing is recorded.
+test_agent_kit_spawn_refuses_without_a_binding() {
+  local rec home proj fakebin out status
+  rec=$(make_home ak-unbound "- proj [agent-kit] - fixture (added 2026-01-01)")
+  IFS='|' read -r home proj fakebin <<EOF
+$rec
+EOF
+  fm_test_fake_agent_kit "$home/config" "$home/akbin"
+  write_brief "$home" ak-unbound-1 agent-kit
+  out=$(run_spawn "$home" "$fakebin" ak-unbound-1 "$proj" claude --mode agent-kit --yolo off)
+  status=$?
+  [ "$status" -ne 0 ] || fail "an unbound agent-kit spawn should exit non-zero"
+  assert_contains "$out" "agent-kit task ak-unbound-1 has no binding" "unbound spawn did not name the missing binding"
+  assert_absent "$home/state/ak-unbound-1.meta" "unbound spawn recorded task metadata"
+
+  printf '{}\n' > "$home/data/ak-unbound-1/agent-kit-binding.json"
+  out=$(run_spawn "$home" "$fakebin" ak-unbound-1 "$proj" claude --mode agent-kit --yolo off)
+  status=$?
+  [ "$status" -ne 0 ] || fail "a binding JSON without the brief section should still refuse"
+  assert_contains "$out" "has no binding" "binding JSON alone satisfied the spawn"
+  assert_absent "$home/state/ak-unbound-1.meta" "half-bound spawn recorded task metadata"
+  pass "fm-spawn: an agent-kit ship refuses without both halves of its binding"
+}
+
+# A full agent-kit spawn to launch: the claude launch carries one --settings flag
+# naming a per-task file that merges the launch's own settings with agent-kit's
+# worker hooks, because claude honours only the last --settings it is given.
+# Every other harness launches with a notice that the child guard is not enforced.
+ak_spawn_case() {  # <name> <harness> <id> -> "<home>|<proj>|<wt>|<fakebin>|<launchlog>"
+  local name=$1 harness=$2 id=$3 case_dir home proj wt fakebin
+  case_dir="$TMP_ROOT/$name"
+  home="$case_dir/home"
+  proj="$case_dir/project"
+  wt="$case_dir/wt"
+  fm_test_spawn_home "$home" "$harness"
+  home=$(cd "$home" && pwd -P)
+  fm_git_worktree "$proj" "$wt" "wt-$name"
+  fakebin=$(fm_test_make_spawn_fakebin "$case_dir/fake")
+  printf '#!/usr/bin/env bash\nshift\nexec "$@"\n' > "$fakebin/timeout"
+  chmod +x "$fakebin/timeout"
+  fm_test_fake_agent_kit "$home/config" "$home/akbin"
+  FM_HOME="$home" "$BRIEF" "$id" "$proj" --mode agent-kit >/dev/null 2>&1 \
+    || fail "$name: agent-kit brief generation should succeed"
+  fill_brief_subsections "$home/data/$id/brief.md" "Ship the agent-kit change." "Keep the bound lifecycle."
+  printf '%s\n' "$home|$proj|$wt|$fakebin|$case_dir/launch.log"
+}
+
+test_agent_kit_claude_launch_uses_the_task_settings_file() {
+  local rec home proj wt fakebin log id=ak-launch-1 out status launch settings inline
+  rec=$(ak_spawn_case ak-launch claude "$id")
+  IFS='|' read -r home proj wt fakebin log <<EOF
+$rec
+EOF
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+  status=$?
+  expect_code 0 "$status" "a bound agent-kit claude spawn should succeed: $out"
+  settings="$home/state/$id.agent-kit-settings.json"
+  launch=$(cat "$log")
+  assert_contains "$launch" "--settings '$settings'" "claude launch did not pass the per-task settings file"
+  assert_not_contains "$launch" '"feedbackDrafts"' "claude launch still carried the inline settings"
+  [ "$(printf '%s\n' "$launch" | grep -o -- '--settings' | wc -l | tr -d ' ')" = 1 ] \
+    || fail "claude launch passed more than one --settings flag"
+  inline='{"feedbackDrafts":"off","attribution":{"commit":"","pr":"","sessionUrl":false}}'
+  jq -e --argjson inline "$inline" '. == ($inline + {hooks: .hooks}) and (.hooks.PreToolUse[0].matcher == "*")' \
+    "$settings" >/dev/null \
+    || fail "per-task settings are not the inline settings plus the worker hooks: $(cat "$settings")"
+  [ "$(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$settings")" = \
+    "ak-child-guard --binding '$home/data/$id/agent-kit-binding.json'" ] \
+    || fail "hook command does not carry the task's quoted binding path: $(cat "$settings")"
+  assert_no_grep '__AK_FIRSTMATE_BINDING__' "$settings" "per-task settings kept the binding placeholder"
+  assert_not_contains "$out" "child guard is not enforced" "claude launch printed the unenforced notice"
+  grep -qx 'Delivery contract: mode=agent-kit' "$home/data/$id/launch-brief.md" \
+    || fail "launch brief lacks the agent-kit delivery contract"
+  assert_grep '# agent-kit binding' "$home/data/$id/launch-brief.md" "launch brief lacks the binding"
+  assert_grep 'it still lets you start task-local native subagents at depth 1' "$home/data/$id/launch-brief.md" \
+    "launch brief lacks the agent-kit role clause"
+  pass "fm-spawn: an agent-kit claude launch uses one per-task settings file carrying the worker hooks"
+}
+
+test_agent_kit_claude_launch_refuses_bad_worker_settings() {
+  local rec home proj wt fakebin log id=ak-badsettings-1 label out status
+  rec=$(ak_spawn_case ak-badsettings claude "$id")
+  IFS='|' read -r home proj wt fakebin log <<EOF
+$rec
+EOF
+  for label in missing invalid nohooks; do
+    case "$label" in
+      missing) rm -f "$home/akbin/worker-settings.json" ;;
+      invalid) printf 'not json\n' > "$home/akbin/worker-settings.json" ;;
+      nohooks) printf '{"hooks":[]}\n' > "$home/akbin/worker-settings.json" ;;
+    esac
+    : > "$log"
+    out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+    status=$?
+    [ "$status" -ne 0 ] || fail "$label worker settings: agent-kit claude spawn should refuse"
+    assert_contains "$out" "agent-kit claude launch for $id refused" "$label worker settings: refusal did not explain itself"
+    assert_absent "$home/state/$id.meta" "$label worker settings: refused spawn recorded task metadata"
+    assert_absent "$home/state/$id.agent-kit-settings.json" "$label worker settings: refused spawn wrote settings"
+    [ ! -s "$log" ] || fail "$label worker settings: refused spawn typed a launch"
+  done
+  pass "fm-spawn: missing or invalid agent-kit worker settings refuse the claude launch"
+}
+
+test_agent_kit_other_harness_prints_the_unenforced_notice() {
+  local rec home proj wt fakebin log id=ak-codex-1 out status
+  rec=$(ak_spawn_case ak-codex codex "$id")
+  IFS='|' read -r home proj wt fakebin log <<EOF
+$rec
+EOF
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+  status=$?
+  expect_code 0 "$status" "a bound agent-kit codex spawn should succeed: $out"
+  assert_contains "$out" "agent-kit child guard is not enforced on harness codex for $id" \
+    "codex launch did not announce the unenforced child guard"
+  assert_absent "$home/state/$id.agent-kit-settings.json" "codex launch wrote claude settings"
+  pass "fm-spawn: a non-claude agent-kit launch proceeds with the unenforced-guard notice"
+}
