+# An agent-kit relaunch reads the same brief a fresh launch did, so the replacement
+# receives the Definition of done, the binding, and the role clause again, and its
+# claude launch re-arms the per-task settings file. Without the binding the
+# relaunch refuses before the running agent is touched.
+test_agent_kit_relaunch_carries_the_bound_contract() {
+  local dir home id=rl-agent-kit brief launch out status
+  dir=$(new_case agent-kit-relaunch "$id")
+  home="$dir/home"
+  fm_git_worktree "$dir/proj" "$dir/wt" "task-$id"
+  fm_test_fake_agent_kit "$home/config" "$dir/akbin"
+  FM_HOME="$home" "$BRIEF" "$id" "$dir/proj" --mode agent-kit >/dev/null \
+    || fail "could not scaffold the agent-kit brief"
+  brief="$home/data/$id/brief.md"
+  sed 's/{TASK}/Ship the agent-kit change./; s/{FIRSTMATE_SPEC}/Keep the bound lifecycle./' "$brief" > "$brief.filled"
+  mv "$brief.filled" "$brief"
+  {
+    echo "window=fmses:fm-$id"
+    echo "endpoint_task_id=$id"
+    echo "worktree=$dir/wt"
+    echo "project=$dir/proj"
+    echo "harness=claude"
+    echo "kind=ship"
+    echo "mode=agent-kit"
+    echo "yolo=off"
+    echo "tasktmp=/tmp/fm-$id"
+    echo "model=default"
+    echo "effort=default"
+  } > "$home/state/$id.meta"
+  printf '%s\n' "fm-$id" > "$dir/fake/windows"
+  printf '%s' "$dir/wt" > "$dir/fake/cwd"
+  printf 'zsh' > "$dir/fake/command"
+  TASK_TMPS+=("/tmp/fm-$id")
+
+  mv "$home/data/$id/agent-kit-binding.json" "$dir/binding.json"
+  cp "$home/state/$id.meta" "$dir/meta.before"
+  out=$(run_spawn "$dir" "$id" --relaunch)
+  status=$?
+  [ "$status" -ne 0 ] || fail "an agent-kit relaunch without its binding should refuse"
+  assert_contains "$out" "agent-kit task $id has no binding" "unbound relaunch did not name the missing binding"
+  [ ! -s "$dir/fake/literal" ] || fail "unbound relaunch typed a launch"
+  cmp -s "$dir/meta.before" "$home/state/$id.meta" || fail "unbound relaunch changed the task record"
+  assert_absent "$home/state/$id.agent-kit-settings.json" "unbound relaunch wrote agent-kit settings"
+  mv "$dir/binding.json" "$home/data/$id/agent-kit-binding.json"
+
+  out=$(run_spawn "$dir" "$id" --relaunch) || fail "agent-kit relaunch should succeed: $out"
+  launch="$home/data/$id/launch-brief.md"
+  grep -qx 'Delivery contract: mode=agent-kit' "$launch" || fail "relaunch lost the agent-kit delivery contract"
+  assert_grep 'no-mistakes axi run --skip review,document,rebase' "$launch" "relaunch lost the agent-kit transport"
+  assert_grep '# agent-kit binding' "$launch" "relaunch lost the binding section"
+  assert_grep 'it still lets you start task-local native subagents at depth 1' "$launch" "relaunch lost the agent-kit role clause"
+  assert_grep "--settings '$(cd "$home/state" && pwd -P)/$id.agent-kit-settings.json'" "$dir/fake/literal" \
+    "relaunch did not launch claude with the per-task settings file"
+  assert_present "$home/state/$id.agent-kit-settings.json" "relaunch did not re-arm the per-task settings file"
+  pass "fm-spawn --relaunch: an agent-kit replacement receives the bound contract and settings, and refuses unbound"
+}
