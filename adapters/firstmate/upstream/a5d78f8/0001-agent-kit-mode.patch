diff --git a/bin/fm-agent-kit-lib.sh b/bin/fm-agent-kit-lib.sh
new file mode 100644
index 00000000..5db134e0
--- /dev/null
+++ b/bin/fm-agent-kit-lib.sh
@@ -0,0 +1,168 @@
+#!/usr/bin/env bash
+# Single owner of the opt-in agent-kit delivery binding: the config/agent-kit.env
+# parser, the `ak firstmate bind` call that renders a ship brief's
+# `# agent-kit binding` section, and the per-task Claude settings merge that
+# carries agent-kit's child guard hooks.
+# Sourced by bin/fm-brief.sh and bin/fm-promote.sh (bind) and by bin/fm-spawn.sh
+# (config and settings). This file is sourced and has no side effects on source.
+# agent-kit judges, no-mistakes delivers: the bound lifecycle owns review, fixes,
+# and the ship decision, and bin/fm-dod-lib.sh owns the Definition of done that
+# points the worker at this section.
+# Every path fails closed. The env file is parsed, never sourced: blank and `#`
+# lines are ignored, every other line must be KEY=value or KEY='value' for one of
+# the three keys below, each exactly once, and a value holding quotes, spaces,
+# `$`, or backticks is refused rather than interpreted.
+#   AK_FIRSTMATE_BIN              absolute path to an executable `ak`
+#   AK_FIRSTMATE_PATCH            the Firstmate patch the binding targets; must be 0001-agent-kit-mode
+#   AK_FIRSTMATE_WORKER_SETTINGS  absolute path to a JSON file whose `hooks` object guards child agents;
+#                                 every __AK_FIRSTMATE_BINDING__ in a hook `command` string becomes the
+#                                 task's shell-quoted binding path in the per-task settings file
+# A bind is accepted only when `ak` exits 0, writes the binding JSON, and prints
+# a section whose first line is exactly `# agent-kit binding` and which holds no
+# `Delivery contract: mode=` line, so the section can never override the mode
+# line bin/fm-spawn.sh checks. A refused bind leaves no binding JSON and removes
+# the task data directory when this call created it.
+
+FM_AGENT_KIT_PATCH_ID=0001-agent-kit-mode
+FM_AGENT_KIT_HEADING='# agent-kit binding'
+FM_AGENT_KIT_BINDING_PLACEHOLDER=__AK_FIRSTMATE_BINDING__
+
+# Load <config-dir>/agent-kit.env into AK_FIRSTMATE_BIN, AK_FIRSTMATE_PATCH, and
+# AK_FIRSTMATE_WORKER_SETTINGS. Prints the reason on stderr and returns 1 on any
+# refusal.
+fm_agent_kit_config_load() {  # <config-dir>
+  local file="$1/agent-kit.env" line key value n=0 seen=' '
+  AK_FIRSTMATE_BIN=
+  AK_FIRSTMATE_PATCH=
+  AK_FIRSTMATE_WORKER_SETTINGS=
+  if [ ! -f "$file" ]; then
+    echo "error: agent-kit mode needs $file; it is missing" >&2
+    return 1
+  fi
+  while IFS= read -r line || [ -n "$line" ]; do
+    n=$((n + 1))
+    case "$line" in
+      '' | '#'*) continue ;;
+    esac
+    key=${line%%=*}
+    if [ "$key" = "$line" ]; then
+      echo "error: $file:$n is not KEY=value" >&2
+      return 1
+    fi
+    value=${line#*=}
+    case "$value" in
+      \'*\')
+        value=${value#\'}
+        value=${value%\'}
+        ;;
+    esac
+    case "$value" in
+      '' | *[\'\"\ \	\$\`\\]*)
+        echo "error: $file:$n has an empty or unsafe value for $key" >&2
+        return 1
+        ;;
+    esac
+    case "$key" in
+      AK_FIRSTMATE_BIN | AK_FIRSTMATE_PATCH | AK_FIRSTMATE_WORKER_SETTINGS) ;;
+      *)
+        echo "error: $file:$n has unknown key '$key'" >&2
+        return 1
+        ;;
+    esac
+    case "$seen" in
+      *" $key "*)
+        echo "error: $file:$n repeats $key" >&2
+        return 1
+        ;;
+    esac
+    seen="$seen$key "
+    case "$key" in
+      AK_FIRSTMATE_BIN) AK_FIRSTMATE_BIN=$value ;;
+      AK_FIRSTMATE_PATCH) AK_FIRSTMATE_PATCH=$value ;;
+      AK_FIRSTMATE_WORKER_SETTINGS) AK_FIRSTMATE_WORKER_SETTINGS=$value ;;
+    esac
+  done <"$file"
+  case "$AK_FIRSTMATE_BIN" in
+    /*) ;;
+    *)
+      echo "error: $file: AK_FIRSTMATE_BIN must be an absolute path" >&2
+      return 1
+      ;;
+  esac
+  if [ ! -f "$AK_FIRSTMATE_BIN" ] || [ ! -x "$AK_FIRSTMATE_BIN" ]; then
+    echo "error: $file: AK_FIRSTMATE_BIN $AK_FIRSTMATE_BIN is missing or not executable" >&2
+    return 1
+  fi
+  if [ "$AK_FIRSTMATE_PATCH" != "$FM_AGENT_KIT_PATCH_ID" ]; then
+    echo "error: $file: AK_FIRSTMATE_PATCH must be $FM_AGENT_KIT_PATCH_ID (got '$AK_FIRSTMATE_PATCH')" >&2
+    return 1
+  fi
+  case "$AK_FIRSTMATE_WORKER_SETTINGS" in
+    /*) ;;
+    *)
+      echo "error: $file: AK_FIRSTMATE_WORKER_SETTINGS must be an absolute path" >&2
+      return 1
+      ;;
+  esac
+}
+
+# Run the bind and print the validated `# agent-kit binding` section on stdout.
+# <project> is the absolute project checkout; <binding-out> is the task's
+# data/<id>/agent-kit-binding.json.
+fm_agent_kit_bind() {  # <config-dir> <fm-home> <task-id> <project> <binding-out>
+  local config=$1 home=$2 id=$3 project=$4 out=$5 dir section rc=0 made_dir=0
+  fm_agent_kit_config_load "$config" || return 1
+  dir=$(dirname "$out")
+  if [ ! -d "$dir" ]; then
+    mkdir -p "$dir" || return 1
+    made_dir=1
+  fi
+  rm -f -- "$out"
+  section=$("$AK_FIRSTMATE_BIN" firstmate bind --fm-home "$home" --task-id "$id" \
+    --project "$project" --mode agent-kit --binding-out "$out") || rc=$?
+  if [ "$rc" -ne 0 ]; then
+    echo "error: agent-kit bind exited $rc for task $id" >&2
+  elif [ "$(printf '%s\n' "$section" | sed -n 1p)" != "$FM_AGENT_KIT_HEADING" ]; then
+    echo "error: agent-kit bind output does not begin with '$FM_AGENT_KIT_HEADING'" >&2
+    rc=1
+  elif printf '%s\n' "$section" | grep -q '^Delivery contract: mode='; then
+    echo "error: agent-kit bind output carries a 'Delivery contract: mode=' line; the Definition of done owns that line" >&2
+    rc=1
+  elif [ ! -s "$out" ]; then
+    echo "error: agent-kit bind wrote no binding at $out" >&2
+    rc=1
+  fi
+  if [ "$rc" -ne 0 ]; then
+    rm -f -- "$out"
+    [ "$made_dir" -eq 0 ] || rmdir "$dir" 2>/dev/null || true
+    return 1
+  fi
+  printf '%s\n' "$section"
+}
+
+# Print <base-json> with the `hooks` object of AK_FIRSTMATE_WORKER_SETTINGS
+# added, as one compact JSON line. Claude honours only the last --settings flag
+# (verified on claude 2.1.281), so the child guard must ride in the same object
+# as the launch's own settings rather than in a second flag. Each hook command
+# is a shell line, so the binding placeholder is replaced by <binding-path>
+# single-quoted for the shell; jq then encodes it as a JSON string.
+fm_agent_kit_claude_settings() {  # <base-json> <binding-path>
+  local base=$1 settings=$AK_FIRSTMATE_WORKER_SETTINGS quoted
+  quoted="'$(printf '%s' "$2" | sed "s/'/'\\\\''/g")'"
+  if ! command -v jq >/dev/null 2>&1; then
+    echo "error: agent-kit claude launches need jq to merge $settings" >&2
+    return 1
+  fi
+  if [ ! -f "$settings" ]; then
+    echo "error: agent-kit worker settings $settings are missing" >&2
+    return 1
+  fi
+  if ! jq -e 'type == "object" and (.hooks | type) == "object"' "$settings" >/dev/null 2>&1; then
+    echo "error: agent-kit worker settings $settings are not a JSON object with a hooks object" >&2
+    return 1
+  fi
+  jq -c --argjson base "$base" --arg placeholder "$FM_AGENT_KIT_BINDING_PLACEHOLDER" --arg binding "$quoted" '
+    def subst: if type == "string" then split($placeholder) | join($binding) else . end;
+    $base + {hooks: (.hooks | walk(if type == "object" and has("command") then .command |= subst else . end))}
+  ' "$settings"
+}
