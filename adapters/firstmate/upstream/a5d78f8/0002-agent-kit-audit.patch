+# AK_FIRSTMATE_WORKER_BUDGET_USD bounds a claude worker with --max-budget-usd.
+# Unset passes no flag; a non-positive or non-numeric value refuses the spawn;
+# a set budget refuses a harness that cannot carry it.
+test_agent_kit_worker_budget() {
+  local rec home proj wt fakebin log id=ak-budget-1 out status settings bad env
+  rec=$(ak_spawn_case ak-budget claude "$id")
+  IFS='|' read -r home proj wt fakebin log <<EOF
+$rec
+EOF
+  env="$home/config/agent-kit.env"
+  cp "$env" "$env.orig"
+  settings="$home/state/$id.agent-kit-settings.json"
+
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+  expect_code 0 "$?" "an unbudgeted agent-kit claude spawn should succeed: $out"
+  assert_not_contains "$(cat "$log")" "--max-budget-usd" "an unset budget still passed --max-budget-usd"
+
+  for bad in 0 0.00 abc -5 1e3 '5 --dangerously-skip-permissions'; do
+    { cat "$env.orig"; printf 'AK_FIRSTMATE_WORKER_BUDGET_USD=%s\n' "$bad"; } > "$env"
+    rm -f "$home/state/$id.meta" "$settings"
+    : > "$log"
+    out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+    status=$?
+    [ "$status" -ne 0 ] || fail "budget '$bad': agent-kit spawn should refuse"
+    assert_contains "$out" "AK_FIRSTMATE_WORKER_BUDGET_USD" "budget '$bad': refusal did not explain itself"
+    assert_absent "$home/state/$id.meta" "budget '$bad': refused spawn recorded task metadata"
+    [ ! -s "$log" ] || fail "budget '$bad': refused spawn typed a launch"
+  done
+
+  { cat "$env.orig"; printf 'AK_FIRSTMATE_WORKER_BUDGET_USD=%s\n' 5; } > "$env"
+  rm -f "$home/state/$id.meta" "$settings"
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+  expect_code 0 "$?" "a budgeted agent-kit claude spawn should succeed: $out"
+  assert_contains "$(cat "$log")" "--settings '$settings' --max-budget-usd 5" "a set budget did not pass --max-budget-usd"
+  [ "$(grep -o -- '--max-budget-usd' "$log" | wc -l | tr -d ' ')" = 1 ] || fail "claude launch passed more than one budget flag"
+
+  { cat "$env.orig"; printf 'AK_FIRSTMATE_WORKER_BUDGET_USD=%s\n' 2.50; } > "$env"
+  rm -f "$home/state/$id.meta" "$settings"
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" "$id" "$proj" --mode agent-kit --yolo off)
+  expect_code 0 "$?" "a fractional budget should be accepted: $out"
+  assert_contains "$(cat "$log")" "--max-budget-usd 2.50" "a fractional budget was not passed through"
+
+  rec=$(ak_spawn_case ak-budget-codex codex ak-budget-2)
+  IFS='|' read -r home proj wt fakebin log <<EOF
+$rec
+EOF
+  printf 'AK_FIRSTMATE_WORKER_BUDGET_USD=%s\n' 5 >> "$home/config/agent-kit.env"
+  : > "$log"
+  out=$(FM_FAKE_LAUNCH_LOG="$log" fm_test_run_spawn "$home" "$wt" "$fakebin" ak-budget-2 "$proj" --mode agent-kit --yolo off)
+  status=$?
+  [ "$status" -ne 0 ] || fail "a budgeted codex agent-kit spawn should refuse"
+  assert_contains "$out" "is enforced only on the claude launch; refusing harness codex for ak-budget-2" \
+    "budgeted codex refusal did not explain itself"
+  [ ! -s "$log" ] || fail "budgeted codex spawn typed a launch"
+  pass "fm-spawn: the agent-kit worker budget becomes --max-budget-usd on claude, is absent when unset, and refuses invalid values"
+}
