+# Firstmate audits every agent-kit done: with `ak firstmate status <binding>
+# --verify`. A pass keeps the done; a refusal or an audit that cannot run turns
+# it into a decision (exit 2) carrying ak's refusal lines; a dry run needs no
+# published head once the audit passes.
+test_agent_kit_done_audit() {
+  local repo wt home state binding line reason rc
+  repo="$TMP_ROOT/ak-audit-repo"
+  wt="$TMP_ROOT/ak-audit-wt"
+  home=$(ak_gate_home ak-audit-home aka publish)
+  state="$home/state"
+  binding="$home/data/aka/agent-kit-binding.json"
+  line='done [at=1]: PR https://github.com/o/r/pull/9 checks green evidence=verify,review'
+  fm_git_worktree "$repo" "$wt" fm/ak-audit
+  git -C "$wt" commit -q --allow-empty -m 'shipped head'
+  git -C "$wt" update-ref refs/remotes/no-mistakes/fm/ak-audit "$(git -C "$wt" rev-parse HEAD)"
+
+  FM_HOME="$home" accept_done ship agent-kit "$wt" "$repo" "$line" "$state" aka "" >/dev/null \
+    || fail "a passing agent-kit audit did not keep the done:"
+  grep -qxF -- "firstmate status $binding --verify --project $wt" "$home/akbin/ak.calls" \
+    || fail "the audit did not run ak firstmate status --verify on the task binding: $(cat "$home/akbin/ak.calls")"
+
+  rc=0
+  reason=$(FM_HOME="$home" FM_FAKE_AK_VERIFY=refuse accept_done ship agent-kit "$wt" "$repo" "$line" "$state" aka "") || rc=$?
+  [ "$rc" -eq 2 ] || fail "a refused agent-kit audit did not refuse as a decision (exit $rc)"
+  [ "$(printf '%s\n' "$reason" | wc -l | tr -d ' ')" = 1 ] || fail "audit refusal is not one line: $reason"
+  case "$reason" in
+    "needs-decision: agent-kit audit refused done (ak exit 1): "*"refused: gate verify has no current evidence; "*"refused: grant ship has no record") ;;
+    *) fail "audit refusal did not carry ak's refusal lines: $reason" ;;
+  esac
+
+  rc=0
+  reason=$(FM_HOME="$home" FM_FAKE_AK_VERIFY=usage accept_done ship agent-kit "$wt" "$repo" "$line" "$state" aka "") || rc=$?
+  [ "$rc" -eq 2 ] || fail "an ak usage exit passed the audit (exit $rc)"
+  assert_contains "$reason" "(ak exit 2)" "usage refusal did not name ak's exit"
+
+  mv "$home/akbin/ak" "$home/akbin/ak.away"
+  rc=0
+  reason=$(FM_HOME="$home" accept_done ship agent-kit "$wt" "$repo" "$line" "$state" aka "") || rc=$?
+  [ "$rc" -eq 2 ] || fail "a missing ak passed the audit (exit $rc)"
+  assert_contains "$reason" "needs-decision: agent-kit audit could not run: " "missing ak did not fail closed as a decision"
+  assert_contains "$reason" "missing or not executable" "missing ak refusal did not name the missing binary"
+  mv "$home/akbin/ak.away" "$home/akbin/ak"
+
+  rc=0
+  reason=$(FM_HOME="$home" accept_done ship agent-kit "$wt" "$repo" "$line" "$state" no-binding "") || rc=$?
+  [ "$rc" -eq 2 ] || fail "an unbound agent-kit done: passed the audit (exit $rc)"
+  assert_contains "$reason" "is missing" "unbound refusal did not name the missing binding"
+
+  rc=0
+  reason=$(FM_HOME="$home" accept_done ship agent-kit "$wt" "$repo" "$line") || rc=$?
+  [ "$rc" -eq 2 ] || fail "an agent-kit done: with no task id passed the audit (exit $rc)"
+
+  # A dry run publishes nothing: the audit alone decides, with no pushed head.
+  home=$(ak_gate_home ak-dry-home akd dry-run)
+  git -C "$wt" commit -q --allow-empty -m 'prepared, never pushed'
+  line='done [at=2]: dry-run ship prepared, nothing published evidence=verify,review'
+  FM_HOME="$home" accept_done ship agent-kit "$wt" "$repo" "$line" "$home/state" akd "" >/dev/null \
+    || fail "a passing dry-run audit did not keep the done: without a published head"
+  rc=0
+  reason=$(FM_HOME="$home" FM_FAKE_AK_VERIFY=refuse accept_done ship agent-kit "$wt" "$repo" "$line" "$home/state" akd "") || rc=$?
+  [ "$rc" -eq 2 ] || fail "a refused dry-run audit kept the done: (exit $rc)"
+  assert_contains "$reason" "needs-decision: " "refused dry-run audit is not a decision"
+
+  # Other modes never call ak.
+  : > "$home/akbin/ak.calls"
+  FM_HOME="$home" accept_done ship direct-PR "$wt" "$repo" 'done: PR https://github.com/o/r/pull/1' "$home/state" akd "" >/dev/null || true
+  [ ! -s "$home/akbin/ak.calls" ] || fail "a direct-PR done: ran the agent-kit audit"
+  pass "an agent-kit done: stands only when Firstmate's ak audit verifies it, and fails closed as a decision"
+}
