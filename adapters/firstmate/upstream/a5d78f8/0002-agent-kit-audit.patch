diff --git a/.agents/skills/project-management/SKILL.md b/.agents/skills/project-management/SKILL.md
index 77586f57..038d7f23 100644
--- a/.agents/skills/project-management/SKILL.md
+++ b/.agents/skills/project-management/SKILL.md
@@ -42,6 +42,7 @@ Choose that posture when adding or creating the project:
 - `direct-PR` pushes and opens a PR without the no-mistakes pipeline.
 - `local-only` has no required remote or PR and lands only through the approved local fast-forward path.
 - `agent-kit` is opt-in and needs `config/agent-kit.env`: agent-kit's bound lifecycle judges the work and no-mistakes only delivers it.
+  A binding with `delivery.action` `dry-run` publishes nothing, and Firstmate audits every agent-kit `done:` with `ak firstmate status <binding> --verify`.
 - `no-mistakes-prod-only` is a conditional policy rather than one flat mode: genuinely internal-only tooling, automation, contributor or operator process, and release or submission work ships `direct-PR`, while product-facing, mixed, and uncertain work ships `no-mistakes`.
 
 `no-mistakes-prod-only` is the default for a newly added or created remote-backed project when the captain specifies nothing, and a project with no remote defaults to `local-only`.
diff --git a/AGENTS.md b/AGENTS.md
index 4ce0fb6f..3e172dd4 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -359,6 +359,8 @@ The path's worker, automated gates, and captain approval remain authoritative:
 - **direct-PR** has the worker push and open a PR without the no-mistakes pipeline, then waits for the configured merge authority.
 - **local-only** has the worker stop with a clean ready branch, then waits for the configured merge authority before firstmate uses the guarded fast-forward merge path.
 - **agent-kit** is opt-in through `config/agent-kit.env` (`bin/fm-agent-kit-lib.sh`): the worker runs the lifecycle in its brief's `# agent-kit binding` section and ships through `no-mistakes axi run --skip review,document,rebase`, then waits for the configured merge authority.
+  A binding whose `delivery.action` is `dry-run` publishes nothing: its worker never runs no-mistakes, pushes, or opens a PR, and reports `done [at=<epoch>]: dry-run ship prepared, nothing published evidence=<refs>` as printed by `ak firstmate status <binding> complete --evidence <refs>`.
+  An optional `AK_FIRSTMATE_WORKER_BUDGET_USD` in `config/agent-kit.env` passes `--max-budget-usd <n>` to the claude worker, and refuses any other harness.
 
 Delivery mode and `yolo` are orthogonal.
 `yolo` governs merge authority only: with it off, the captain approves every PR merge and every local-only landing; with it on, firstmate merges green, in-scope work itself.
@@ -405,6 +407,9 @@ A direct-PR worker pushes that commit to its PR branch, and a local-only worker
 A no-mistakes worker re-validates it with /no-mistakes so the pipeline stays the one publisher; it never pushes from its copy.
 An agent-kit worker re-ships it through its bound lifecycle for the same reason.
 In no-mistakes mode the earlier `done [at=<epoch>]: {summary}` is the pipeline handoff and is not gated; agent-kit has no such handoff, so its every ship `done:` is gated.
+An agent-kit `done:` is also audited: Firstmate runs `ak firstmate status <binding> --verify` itself, and only exit 0 keeps the done.
+A refused audit, or one that cannot run because `ak` is missing, reads `parked` with a `needs-decision:` reason carrying ak's refusal lines, so decide it with the captain rather than steering the worker to ship again.
+A dry-run done has no named head to gate, so that audit alone decides it.
 Tell the captain the PR's full `https://...` URL copied from the worker's ready line, the resolved checks-green crew-state line, or the task's `pr=` metadata, a concise outcome summary, and the no-mistakes risk level when applicable.
 A captain instruction to merge is explicit authority; `yolo` is the only standing routine merge authority.
 For any custom `state/<id>.check.sh` you write yourself, keep it an ordinary single-link mode-`0700` file, print one line only when firstmate should wake, print nothing otherwise, finish before `FM_CHECK_TIMEOUT`, then bind its current bytes with `bin/fm-check-register.sh <id>` before the watcher may execute it.
diff --git a/bin/fm-agent-kit-lib.sh b/bin/fm-agent-kit-lib.sh
index 4100ff23..df1fd977 100644
--- a/bin/fm-agent-kit-lib.sh
+++ b/bin/fm-agent-kit-lib.sh
@@ -2,40 +2,55 @@
 # Single owner of the opt-in agent-kit delivery binding: the config/agent-kit.env
 # parser, the `ak firstmate bind` call that renders a ship brief's
 # `# agent-kit binding` section, and the per-task Claude settings merge that
-# carries agent-kit's child guard hooks.
-# Sourced by bin/fm-brief.sh and bin/fm-promote.sh (bind) and by bin/fm-spawn.sh
-# (config and settings). This file is sourced and has no side effects on source.
+# carries agent-kit's child guard hooks, the binding's delivery action, and the
+# supervisor audit (`ak firstmate status <binding> --verify`) of a worker's done:.
+# Sourced by bin/fm-brief.sh and bin/fm-promote.sh (bind), by bin/fm-spawn.sh
+# (config, settings, and worker budget), and by bin/fm-dod-lib.sh (action and
+# audit). This file is sourced and has no side effects on source.
 # agent-kit judges, no-mistakes delivers: the bound lifecycle owns review, fixes,
 # and the ship decision, and bin/fm-dod-lib.sh owns the Definition of done that
 # points the worker at this section.
 # Every path fails closed. The env file is parsed, never sourced: blank and `#`
 # lines are ignored, every other line must be KEY=value or KEY='value' for one of
-# the three keys below, each exactly once, and a value holding quotes, spaces,
-# `$`, or backticks is refused rather than interpreted.
+# the keys below, each at most once (the first three are required), and a value
+# holding quotes, spaces, `$`, or backticks is refused rather than interpreted.
 #   AK_FIRSTMATE_BIN              absolute path to an executable `ak`
 #   AK_FIRSTMATE_PATCH            the Firstmate patch the binding targets; must be 0001-agent-kit-mode
 #   AK_FIRSTMATE_WORKER_SETTINGS  absolute path to a JSON file whose `hooks` object guards child agents;
 #                                 its hook `command` strings must carry the single-quoted token
 #                                 '__AK_FIRSTMATE_BINDING__', which becomes the task's absolute binding
 #                                 path in the per-task settings file
+#   AK_FIRSTMATE_WORKER_BUDGET_USD optional; a positive decimal number of US dollars that
+#                                 bin/fm-spawn.sh passes to an agent-kit claude worker as
+#                                 `--max-budget-usd`; unset passes no flag, and an agent-kit
+#                                 launch on any other harness is refused while it is set
 # A bind is accepted only when `ak` exits 0, writes the binding JSON, and prints
 # a section whose first line is exactly `# agent-kit binding` and which holds no
 # `Delivery contract: mode=` line, so the section can never override the mode
 # line bin/fm-spawn.sh checks. A refused bind leaves no binding JSON and removes
-# the task data directory when this call created it.
+# the task data directory when this call created it, and so does a binding whose
+# delivery.action is not `publish` or `dry-run`.
+# The audit runs AK_FIRSTMATE_BIN, bounded by FM_AGENT_KIT_VERIFY_TIMEOUT
+# seconds, and fails closed: a missing or refused config, a missing binding, a
+# missing `ak`, a timeout, or any non-zero exit is a refusal, never a pass.
 
 FM_AGENT_KIT_PATCH_ID=0001-agent-kit-mode
 FM_AGENT_KIT_HEADING='# agent-kit binding'
 FM_AGENT_KIT_BINDING_PLACEHOLDER=__AK_FIRSTMATE_BINDING__
+FM_AGENT_KIT_VERIFY_TIMEOUT=60
 
-# Load <config-dir>/agent-kit.env into AK_FIRSTMATE_BIN, AK_FIRSTMATE_PATCH, and
-# AK_FIRSTMATE_WORKER_SETTINGS. Prints the reason on stderr and returns 1 on any
-# refusal.
+# shellcheck source=bin/fm-timeout-lib.sh
+. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fm-timeout-lib.sh"
+
+# Load <config-dir>/agent-kit.env into AK_FIRSTMATE_BIN, AK_FIRSTMATE_PATCH,
+# AK_FIRSTMATE_WORKER_SETTINGS, and AK_FIRSTMATE_WORKER_BUDGET_USD (empty when
+# unset). Prints the reason on stderr and returns 1 on any refusal.
 fm_agent_kit_config_load() {  # <config-dir>
   local file="$1/agent-kit.env" line key value n=0 seen=' '
   AK_FIRSTMATE_BIN=
   AK_FIRSTMATE_PATCH=
   AK_FIRSTMATE_WORKER_SETTINGS=
+  AK_FIRSTMATE_WORKER_BUDGET_USD=
   if [ ! -f "$file" ]; then
     echo "error: agent-kit mode needs $file; it is missing" >&2
     return 1
@@ -64,7 +79,7 @@ fm_agent_kit_config_load() {  # <config-dir>
         ;;
     esac
     case "$key" in
-      AK_FIRSTMATE_BIN | AK_FIRSTMATE_PATCH | AK_FIRSTMATE_WORKER_SETTINGS) ;;
+      AK_FIRSTMATE_BIN | AK_FIRSTMATE_PATCH | AK_FIRSTMATE_WORKER_SETTINGS | AK_FIRSTMATE_WORKER_BUDGET_USD) ;;
       *)
         echo "error: $file:$n has unknown key '$key'" >&2
         return 1
@@ -81,6 +96,7 @@ fm_agent_kit_config_load() {  # <config-dir>
       AK_FIRSTMATE_BIN) AK_FIRSTMATE_BIN=$value ;;
       AK_FIRSTMATE_PATCH) AK_FIRSTMATE_PATCH=$value ;;
       AK_FIRSTMATE_WORKER_SETTINGS) AK_FIRSTMATE_WORKER_SETTINGS=$value ;;
+      AK_FIRSTMATE_WORKER_BUDGET_USD) AK_FIRSTMATE_WORKER_BUDGET_USD=$value ;;
     esac
   done <"$file"
   case "$AK_FIRSTMATE_BIN" in
@@ -105,6 +121,12 @@ fm_agent_kit_config_load() {  # <config-dir>
       return 1
       ;;
   esac
+  [ -n "$AK_FIRSTMATE_WORKER_BUDGET_USD" ] || return 0
+  if ! printf '%s\n' "$AK_FIRSTMATE_WORKER_BUDGET_USD" | grep -Eq '^[0-9]+(\.[0-9]+)?$' \
+    || printf '%s\n' "$AK_FIRSTMATE_WORKER_BUDGET_USD" | grep -Eq '^0+(\.0+)?$'; then
+    echo "error: $file: AK_FIRSTMATE_WORKER_BUDGET_USD must be a positive number of US dollars (got '$AK_FIRSTMATE_WORKER_BUDGET_USD')" >&2
+    return 1
+  fi
 }
 
 # Run the bind and print the validated `# agent-kit binding` section on stdout.
@@ -132,6 +154,8 @@ fm_agent_kit_bind() {  # <config-dir> <fm-home> <task-id> <project> <binding-out
   elif [ ! -s "$out" ]; then
     echo "error: agent-kit bind wrote no binding at $out" >&2
     rc=1
+  elif ! fm_agent_kit_binding_action "$out" >/dev/null; then
+    rc=1
   fi
   if [ "$rc" -ne 0 ]; then
     rm -f -- "$out"
@@ -188,3 +212,64 @@ fm_agent_kit_claude_settings() {  # <base-json> <binding-path>
     $base + {hooks: (.hooks | walk(if type == "object" and has("command") then .command |= subst else . end))}
   ' "$settings"
 }
+
+# The task's binding file in this home's data directory.
+fm_agent_kit_binding_path() {  # <task-id>
+  printf '%s/%s/agent-kit-binding.json\n' "${FM_DATA_OVERRIDE:-${FM_HOME:-}/data}" "$1"
+}
+
+# Print the binding's delivery.action, `publish` or `dry-run`. Anything else,
+# an unreadable binding, or a missing jq prints the reason on stderr and
+# returns 1, so no caller renders or accepts a delivery it cannot name.
+fm_agent_kit_binding_action() {  # <binding-json>
+  local binding=$1 action=
+  if ! command -v jq >/dev/null 2>&1; then
+    echo "error: agent-kit needs jq to read the delivery action of $binding" >&2
+    return 1
+  fi
+  action=$(jq -r 'if type == "object" and (.delivery | type) == "object" then (.delivery.action | strings) else empty end' \
+    "$binding" 2>/dev/null) || action=
+  case "$action" in
+    publish | dry-run) printf '%s\n' "$action" ;;
+    *)
+      echo "error: agent-kit binding $binding has no delivery.action of publish or dry-run" >&2
+      return 1
+      ;;
+  esac
+}
+
+# Firstmate's own audit of an agent-kit worker's done:, the same check
+# `ak firstmate status <binding> complete` ran before printing that line.
+# 0 when `ak firstmate status <binding> --verify` exits 0. Otherwise prints one
+# line on stdout - the reason, or every `refused:` line ak printed joined with
+# "; " - and returns 1. <worktree>, when it is a directory, is passed as
+# --project so the worker's own commits answer the audit's ancestry checks.
+fm_agent_kit_verify_done() {  # <config-dir> <binding-json> [<worktree>]
+  local config=$1 binding=$2 wt=${3:-} out rc=0
+  local -a args
+  if ! fm_agent_kit_config_load "$config" 2>/dev/null; then
+    out=$(fm_agent_kit_config_load "$config" 2>&1 >/dev/null)
+    printf 'agent-kit audit could not run: %s\n' "$(fm_agent_kit_one_line "$out")"
+    return 1
+  fi
+  if [ ! -f "$binding" ]; then
+    printf 'agent-kit audit could not run: binding %s is missing\n' "$binding"
+    return 1
+  fi
+  args=(firstmate status "$binding" --verify)
+  [ -z "$wt" ] || [ ! -d "$wt" ] || args+=(--project "$wt")
+  out=$(fm_run_timed "$FM_AGENT_KIT_VERIFY_TIMEOUT" "$AK_FIRSTMATE_BIN" "${args[@]}" </dev/null 2>&1) || rc=$?
+  [ "$rc" -ne 0 ] || return 0
+  if [ "$rc" -eq 124 ]; then
+    printf 'agent-kit audit timed out after %ss\n' "$FM_AGENT_KIT_VERIFY_TIMEOUT"
+    return 1
+  fi
+  out=$(fm_agent_kit_one_line "$out")
+  printf 'agent-kit audit refused done (ak exit %s): %s\n' "$rc" "${out:-no output}"
+  return 1
+}
+
+# Join the non-empty lines of <text> with "; ".
+fm_agent_kit_one_line() {  # <text>
+  printf '%s\n' "$1" | awk 'NF { printf "%s%s", (n++ ? "; " : ""), $0 }'
+}
