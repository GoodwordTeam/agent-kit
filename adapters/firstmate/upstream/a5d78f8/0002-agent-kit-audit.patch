+# The delivery action of an agent-kit task's <binding>: `publish` or
+# `dry-run`. A missing binding or any other action refuses rather than
+# rendering a contract the binding does not name.
+fm_dod_agent_kit_action() {  # <binding>
+  if [ -z "$1" ]; then
+    echo "error: agent-kit delivery needs the task's binding file to name its delivery action" >&2
+    return 1
+  fi
+  fm_agent_kit_binding_action "$1"
+}
+
+fm_dod_block() {  # <mode> <task-id> [<agent-kit-binding>]
+  local mode=$1 id=$2 binding=${3:-} action
   case "$mode" in
     direct-PR)
       cat <<EOF
@@ -379,6 +405,29 @@ If you deliberately keep the PR a draft, append \`paused [at=<epoch>]: {why the
 EOF
       ;;
     agent-kit)
+      action=$(fm_dod_agent_kit_action "$binding") || return 1
+      if [ "$action" = dry-run ]; then
+        cat <<EOF
+# Definition of done
+Delivery contract: mode=agent-kit
+This task ships **agent-kit** as a dry run: agent-kit judges the work, and nothing is published.
+The task is complete only when committed on your branch.
+Run the lifecycle bound in \`# agent-kit binding\` below; super-ship owns the ship decision and, because the binding's delivery action is \`dry-run\`, prepares the ship without publishing it.
+Do not run no-mistakes, push, open a PR, or merge: there is no pipeline, no CI, and no PR in this task.
+
+Firstmate-specific rules layer on top of that guidance:
+- ask-user findings are never yours to answer: escalate to firstmate using rule 6's ask-user format and stop.
