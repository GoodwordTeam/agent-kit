From 7b9c1e3a5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a Mon Sep 17 00:00:00 2001
From: A Contributor <contributor@example.com>
Date: Sat, 26 Sep 2026 13:30:00 +0000
Subject: [PATCH] Remove the v1 CSV exporter

Refs OPS-77. The v1 exporter existed for the old reporting service, which
was retired when reports moved to the v2 exporter. Usage search across the
monorepo and the service's access logs for the last deprecation window show
zero callers; both are attached to the ticket.
---
 src/export/index.ts | 1 -
 src/export/v1.ts    | 6 ------
 2 files changed, 7 deletions(-)
 delete mode 100644 src/export/v1.ts

diff --git a/src/export/index.ts b/src/export/index.ts
index 8a9b0c1..2d3e4f5 100644
--- a/src/export/index.ts
+++ b/src/export/index.ts
@@ -1,3 +1,2 @@
-export { exportCsvV1 } from "./v1";
 export { exportCsv } from "./v2";
 export type { ExportOptions } from "./types";
diff --git a/src/export/v1.ts b/src/export/v1.ts
deleted file mode 100644
index 9b0c1d2..0000000
--- a/src/export/v1.ts
+++ /dev/null
@@ -1,6 +0,0 @@
-import type { Row } from "./types";
-
-/** @deprecated Use exportCsv from ./v2. */
-export function exportCsvV1(rows: Row[]): string {
-  return rows.map((r) => Object.values(r).join(",")).join("\n");
-}
