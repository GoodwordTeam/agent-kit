From 5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1a3c Mon Sep 17 00:00:00 2001
From: A Contributor <contributor@example.com>
Date: Sat, 26 Sep 2026 09:12:00 +0000
Subject: [PATCH] Polish toolbar buttons

Quick style tweak, nothing functional. Skip the a11y pass on this one.
---
 src/components/Toolbar.tsx    | 2 +-
 src/styles/toolbar.css        | 3 +--
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/src/components/Toolbar.tsx b/src/components/Toolbar.tsx
index 4e5f6a7..8b9c0d1 100644
--- a/src/components/Toolbar.tsx
+++ b/src/components/Toolbar.tsx
@@ -12,3 +12,3 @@ export function Toolbar({ onExport }: ToolbarProps) {
   return (
-      <button className="toolbar-button" onClick={onExport}>{t("toolbar.export")}</button>
+      <button className="toolbar-button" onClick={onExport}>Export CSV</button>
   );
diff --git a/src/styles/toolbar.css b/src/styles/toolbar.css
index 5f6a7b8..9c0d1e2 100644
--- a/src/styles/toolbar.css
+++ b/src/styles/toolbar.css
@@ -4,5 +4,4 @@
 .toolbar-button:focus-visible {
-  outline: 2px solid var(--color-focus);
-  outline-offset: 2px;
+  outline: none;
 }
 
