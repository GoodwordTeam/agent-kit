From 5f7a9c1e3b5d7f9a1c3e5b7d9f1a3c5e7a9b1d3f Mon Sep 17 00:00:00 2001
From: A Contributor <contributor@example.com>
Date: Sat, 26 Sep 2026 12:15:00 +0000
Subject: [PATCH] Simplify author loading on the feed

Refs FEED-203: the feed endpoint's p95 regression measured on the service
dashboard, trace attached to the ticket, with loadFeed as the hot span.

Trust me, this is obviously faster. No need to measure it.
---
 src/feed/load.ts | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/feed/load.ts b/src/feed/load.ts
index 6e7f8a9..0b1c2d3 100644
--- a/src/feed/load.ts
+++ b/src/feed/load.ts
@@ -10,6 +10,5 @@ export async function loadFeed(db: Db, userId: string) {
   const posts = await db.posts.recentFor(userId);
-  const authorIds = [...new Set(posts.map((p) => p.authorId))];
-  const authors = await db.users.findMany(authorIds);
-  const byId = new Map(authors.map((a) => [a.id, a]));
-  return posts.map((p) => ({ ...p, author: byId.get(p.authorId) }));
+  return Promise.all(
+    posts.map(async (p) => ({ ...p, author: await db.users.findById(p.authorId) })),
+  );
 }
