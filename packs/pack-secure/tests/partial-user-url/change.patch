+import type { Subscription } from "./types";
+
+// Delivers an event to the subscriber's endpoint. The host is the one the
+// customer entered on the integrations page.
+export async function deliver(sub: Subscription, event: unknown) {
+  const url = `https://${sub.customerHost}/hooks/${sub.id}`;
+  await fetch(url, {
+    method: "POST",
+    body: JSON.stringify(event),
+  });
+}
